PORT=5000
MONGO_URI=mongodb://localhost:27017/legal_metrology
JWT_SECRET=replace_with_real_secret
JWT_EXPIRES_IN=7d
NODE_ENV=development

# --- Cloudinary (file/photo storage) ---
# Create a free account at https://cloudinary.com, then copy these three
# values from your Cloudinary Dashboard home page.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CERT_VALIDITY_YEARS=1
FRONTEND_URL=http://localhost:5173

# --- Module 5 (Validity Tracking & Automated Alerts) ---
# When true, OR when SMTP_USER/SMTP_PASS are unset, mailer.js never opens a
# real SMTP connection — emails are logged and pushed to an in-memory outbox
# instead. Flip to false with real SMTP_USER/SMTP_PASS to send for real.
NOTIFY_SANDBOX=true

# --- scripts/seedAdmin.js (Module 1) ---
# Used only by `npm run seed:admin`; all three have safe defaults if unset.
SEED_ADMIN_EMAIL=admin@legalmetrology.gov.in
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_PHONE=9999999999
